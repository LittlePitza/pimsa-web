# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
.env.hostinger

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# TypeScript
*.tsbuildinfo
# Auto-generated by Next.js on dev/build — must not be tracked (its content
# flips between .next/dev and .next/types paths, which breaks CI typecheck).
next-env.d.ts

# Testing
coverage/

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Vercel (not used for hosting, but just in case)
.vercel/

# Claude Code local config (machine-specific)
.claude/

# Generated document exports (source of truth is the .md files)
docs/*.docx
~$*.docx
