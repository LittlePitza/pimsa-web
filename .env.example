# ── Database (Hostinger hPanel → Databases → MySQL) ──────────────────────────
# mysql://USER:PASSWORD@HOST:3306/DATABASE
# Apply migrations after each deploy with: npm run db:migrate
DATABASE_URL=

# ── Admin panel auth ─────────────────────────────────────────────────────────
# Random secret for session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Also the key that encrypts the SMTP password stored from the panel — changing
# it signs everyone out AND makes that password unreadable, and the site falls
# back to the SMTP_* variables below until it is captured again.
AUTH_SECRET=
# Create the first admin user with:
#   npm run admin:create -- correo@plasticospimsa.com "contraseña-segura" "Nombre"
# Super-admins (comma-separated) may manage accounts in the panel (create users,
# change emails, reset passwords). Defaults to sistemas@plasticospimsa.com.
SUPER_ADMIN_EMAILS=sistemas@plasticospimsa.com

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical URL of the deployed site (no trailing slash).
# Used for metadata, canonical links, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://plasticospimsa.com

# ── Analytics (optional until Marketing provides accounts) ───────────────────
# Google Tag Manager container ID (GTM-XXXXXXX). Loaded only after cookie consent.
NEXT_PUBLIC_GTM_ID=

# ── Email delivery (SMTP) ────────────────────────────────────────────────────
# Everything in this block is a FALLBACK. The panel (/admin/configuracion) is
# the primary place to configure email: recipients per flow, CC/BCC, the
# sending mailbox, test sends and the delivery log all live there and apply
# without a redeploy. These variables cover the site until someone opens it —
# and keep it sending if the settings rows are ever lost.
#
# Hostinger provides SMTP with any hosted mailbox (smtp.hostinger.com : 465).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=web@plasticospimsa.com
SMTP_PASS=
# Where contact-form leads are delivered (comma-separated for multiple).
# Not contacto@ on purpose: that is the public address the site displays,
# while the lead notification goes to whoever works it.
CONTACT_EMAIL_TO=marketing@plasticospimsa.com
# Where job applications are delivered — RRHH only, never the general inbox:
# these carry the candidate's CV. Left empty the application is still stored
# and readable in /admin/postulaciones, it just isn't emailed to anyone.
APPLICATIONS_EMAIL_TO=gte.rh@plasticospimsa.com
# From address shown on the emails (must be a mailbox of the SMTP account domain).
CONTACT_EMAIL_FROM=web@plasticospimsa.com
